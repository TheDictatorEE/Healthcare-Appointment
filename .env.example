# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Postgres - use Supabase / Render / Railway / Azure PG free tier)
DATABASE_URL="postgresql://user:password@localhost:5432/healthcare_db?schema=public"

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Gemini LLM
GEMINI_API_KEY=your_gemini_api_key_from_aistudio.google.com

# Email (choose one - example uses SMTP/Nodemailer with Gmail or SendGrid SMTP relay)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM="Clinic Appointments <no-reply@yourclinic.com>"

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
