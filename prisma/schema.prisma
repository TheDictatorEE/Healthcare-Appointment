generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  BOOKING_CONFIRMATION
  REMINDER
  CANCELLATION
  LEAVE_CONFLICT
  MEDICATION_REMINDER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  role          Role
  name          String
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Google Calendar OAuth tokens (per user, since both patient & doctor get events)
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?

  doctorProfile      DoctorProfile?
  patientAppointments Appointment[] @relation("PatientAppointments")
  notifications       Notification[]
}

model DoctorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialisation String
  slotDurationMin Int     @default(30)
  workingHours   Json     // e.g. { "mon": ["09:00","17:00"], "tue": [...], ... "sun": null }

  leaves         DoctorLeave[]
  appointments   Appointment[] @relation("DoctorAppointments")

  @@index([specialisation])
}

model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime // leave day (date only, time ignored)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([doctorId, date])
}

model Appointment {
  id            String   @id @default(uuid())

  patientId     String
  patient       User     @relation("PatientAppointments", fields: [patientId], references: [id])

  doctorId      String
  doctor        DoctorProfile @relation("DoctorAppointments", fields: [doctorId], references: [id])

  slotStart     DateTime
  slotEnd       DateTime
  status        AppointmentStatus @default(BOOKED)

  // Pre-visit
  symptoms          String?
  preVisitSummary   Json?     // { urgencyLevel, chiefComplaint, suggestedQuestions }
  urgencyLevel      Urgency?
  preVisitLlmFailed Boolean  @default(false)

  // Post-visit
  clinicalNotes      String?
  prescription        Json?    // [{ medicine, dosage, frequency, durationDays }]
  postVisitSummary    Json?    // { summary, medicationSchedule, followUpSteps }
  postVisitLlmFailed  Boolean  @default(false)

  // Google Calendar
  patientCalendarEventId String?
  doctorCalendarEventId  String?

  cancelReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  notifications  Notification[]
  reminders      MedicationReminder[]

  // CRITICAL: prevents double-booking at the DB level, not just app logic
  @@unique([doctorId, slotStart])
  @@index([patientId])
  @@index([doctorId, slotStart])
}

model MedicationReminder {
  id             String   @id @default(uuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  medicine       String
  dosage         String
  scheduledAt    DateTime
  sent           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([scheduledAt, sent])
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  type           NotificationType
  status         NotificationStatus @default(PENDING)
  attempts       Int      @default(0)
  lastError      String?
  payload        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, attempts])
}
